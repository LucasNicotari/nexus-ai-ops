# PostgreSQL local development settings
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Comma-separated machine credentials as api-key:role. Generate a high-entropy key and never commit .env.
NEXUS_API_KEYS=replace-with-a-long-random-key:reader
