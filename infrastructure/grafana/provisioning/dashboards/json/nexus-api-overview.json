{
  "annotations": {"list": []},
  "editable": true,
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum(rate(nexus_api_requests_total[1m]))", "refId": "A"}],
      "title": "Requests per second",
      "type": "timeseries"
    },
    {
      "datasource": "NEXUS PostgreSQL",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
      "id": 4,
      "targets": [{"format": "table", "rawSql": "SELECT COUNT(*) AS total_events FROM operational_events", "refId": "A"}],
      "title": "Persisted operational events",
      "type": "stat"
    },
    {
      "datasource": "NEXUS PostgreSQL",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16},
      "id": 5,
      "targets": [{"format": "table", "rawSql": "SELECT COUNT(*) AS anomalous_events FROM operational_events WHERE is_anomaly", "refId": "A"}],
      "title": "Anomalous events",
      "type": "stat"
    },
    {
      "datasource": "NEXUS PostgreSQL",
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16},
      "id": 6,
      "targets": [{"format": "table", "rawSql": "SELECT service, COUNT(*) AS anomalous_events, COUNT(*) FILTER (WHERE severity = 'critical') AS critical_events FROM operational_events WHERE is_anomaly GROUP BY service ORDER BY critical_events DESC, anomalous_events DESC", "refId": "A"}],
      "title": "Services with anomalous signals",
      "type": "table"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(nexus_api_request_duration_seconds_bucket[1m])) by (le))", "refId": "A"}],
      "title": "API latency p95",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "id": 3,
      "targets": [{"expr": "sum by (path, status_code) (rate(nexus_api_requests_total[1m]))", "legendFormat": "{{path}} {{status_code}}", "refId": "A"}],
      "title": "Request rate by route and status",
      "type": "timeseries"
    }
  ],
